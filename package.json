{
  "name": "vscode-c3",
  "displayName": "C3 Language Support for VSCode",
  "description": "C3 Language Support for VSCode - Syntax Highlighting and Code Snippets",
  "publisher": "c3",
  "repository": "https://github.com/c3lang/vscode-c3.git",
  "version": "0.3.8",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Debuggers"
  ],
  "icon": "images/icon.png",
  "license": "MIT",
  "contributes": {
    "languages": [
      {
        "id": "c3",
        "aliases": [
          "C3",
          "c3"
        ],
        "extensions": [
          ".c3",
          ".c3i",
          ".c3t"
        ],
        "configuration": "./language-configuration.json",
        "icon":{
          "light": "./images/c3.svg",
          "dark": "./images/c3.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "c3",
        "scopeName": "source.vscode.c3",
        "path": "./syntaxes/c3.vscode.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "c3",
        "scopes": {
          "namespace": ["entity.name.namespace.c3", "entity.name.namespace"],
          "type": ["entity.name.type.c3", "entity.name.type"],
          "function": ["entity.name.function.c3", "entity.name.function"],
          "macro": ["entity.name.function.c3", "entity.name.function"],
          "variable": ["variable.other.c3", "variable.other"],
          "enumMember": ["variable.other.constant.c3", "constant.other"],
          "decorator": ["keyword.annotation.c3", "entity.name.decorator"],
          "keyword": ["keyword.control.c3", "keyword.control", "keyword"],
          "comment": ["comment.line.c3", "comment"],
          "string": ["string.quoted.c3", "string"],
          "number": ["constant.numeric.c3", "constant.numeric"],
          "class": ["entity.name.type.c3", "entity.name.type"],
          "parameter": ["variable.parameter.c3", "variable.parameter"],
          "property": ["variable.other.property.c3", "variable.other.property", "variable.other"],
          "typeParameter": ["storage.type.decl-accent.c3", "storage.type"]
        }
      }
    ],
    "snippets": [
      {
        "language": "c3",
        "path": "./snippets/snippets.json"
      }
    ],
    "commands": [
      {
        "command": "c3.reinstallTools",
        "title": "Re-download tools (c3-lsp and c3fmt)",
        "category": "C3"
      },
      {
        "command": "c3.checkForUpdates",
        "title": "Check for tool updates",
        "category": "C3"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "title": "C3 Language Support",
        "order": 1,
        "properties": {
          "c3.stdlib-path": {
            "type": "string",
            "default": null,
            "markdownDescription": "Path to c3c stdlib"
          },
          "c3.lsp.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enables the language server"
          },
          "c3.lsp.path": {
            "type": "string",
            "default": null,
            "scope": "machine",
            "markdownDescription": "The path to the **c3-lsp** binary. If left empty, the extension downloads and manages it automatically. Set this to use a custom build. To disable the language server entirely, turn off `#c3.lsp.enable#`."
          },
          "c3.lsp.sendCrashReports": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Sends crash reports to server to help fixing bugs."
          },
          "c3.lsp.debug": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Enables debug information logging"
          },
          "c3.lsp.log.path": {
            "type": "string",
            "default": "",
            "description": "Saves log to specified file"
          },
          "c3.lsp.diagnosticsDelay": {
            "type": "integer",
            "default": 2000,
            "markdownDescription": "Delay calculation of code diagnostics after modifications in source. In milliseconds, default 2000 ms."
          },
          "c3.lsp.compilerPath": {
            "type": "string",
            "default": "c3c",
            "markdownDescription": "Path to the `c3c` compiler binary, used for diagnostics. Defaults to `c3c` (found via PATH)."
          },
          "c3.debug.backend": {
            "type": "string",
            "enum": [
              "auto",
              "lldb",
              "gdb"
            ],
            "enumDescriptions": [
              "LLDB on macOS, GDB on all other platforms.",
              "Always use lldb-dap.",
              "Always use GDB 14+ with DAP support."
            ],
            "default": "auto",
            "markdownDescription": "Which debugger backend to drive. `auto` picks **lldb** on macOS (GDB has no working arm64-darwin build) and **gdb** elsewhere."
          },
          "c3.debug.path": {
            "type": "string",
            "default": null,
            "scope": "machine",
            "markdownDescription": "Path to the debug adapter for the backend selected in `#c3.debug.backend#` — `lldb-dap` for **lldb**, GDB 14+ with DAP support (`--interpreter=dap`) for **gdb**.\n\nLeave empty to find it automatically: `lldb-dap` is looked up on `PATH`, then via `xcrun -f lldb-dap`, then in the Homebrew LLVM and Xcode Command Line Tools locations; GDB is taken from `PATH`.\n\nA launch configuration can override this per backend with its own `lldbDapPath` or `gdbPath` attribute."
          },
          "c3.format.enable": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Enables formatting via [c3fmt](https://github.com/lmichaudel/c3fmt)"
          },
          "c3.format.path": {
            "type": "string",
            "default": null,
            "scope": "machine",
            "markdownDescription": "The path to the `c3fmt` binary. If left empty, the extension downloads and manages it automatically. Set this to use a custom build. To disable formatting entirely, turn off `#c3.format.enable#`."
          }
        }
      },
      {
        "type": "object",
        "title": "Tools",
        "order": 2,
        "properties": {
          "c3.tools.checkForUpdate": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Whether to automatically check for new versions of the managed binaries on startup.\n\nThe actions below apply to **both** tools, c3-lsp and c3fmt:\n\n[Check for updates now](command:c3.checkForUpdates) — asks GitHub for the latest release of each and offers to install what is newer.\n\n[Re-download tools](command:c3.reinstallTools) — deletes both managed binaries and downloads the latest release of each, whatever version is installed."
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "c3"
      }
    ],
    "debuggers": [
      {
        "type": "c3",
        "label": "C3 Debug (LLDB/GDB)",
        "languages": [
          "c3"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the compiled C3 executable to debug.",
                "default": "${workspaceFolder}/build/${workspaceFolderBasename}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments passed to the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the program being debugged.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables to set for the program.",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop the program at the entry point.",
                "default": false
              },
              "backend": {
                "type": "string",
                "enum": [
                  "auto",
                  "lldb",
                  "gdb"
                ],
                "description": "Debugger backend for this configuration (overrides c3.debug.backend setting). 'auto' uses LLDB on macOS and GDB elsewhere."
              },
              "lldbDapPath": {
                "type": "string",
                "description": "Path to lldb-dap executable, used when this configuration runs on the lldb backend (overrides the c3.debug.path setting)."
              },
              "gdbPath": {
                "type": "string",
                "description": "Path to GDB executable, used when this configuration runs on the gdb backend (overrides the c3.debug.path setting)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "c3",
            "request": "launch",
            "name": "Debug C3 Program",
            "program": "${workspaceFolder}/build/${workspaceFolderBasename}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "C3: Launch Program",
            "description": "Launch and debug a compiled C3 program using GDB",
            "body": {
              "type": "c3",
              "request": "launch",
              "name": "${2:Debug C3 Program}",
              "program": "^\"\\${workspaceFolder}/build/${1:program_name}\"",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "configurationDefaults": {
      "[c3]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.formatOnSave": false
      },
      "files.associations": {
        "project.json": "jsonc"
      }
    }
  },
  "activationEvents": [
    "onLanguage:c3",
    "onDebugResolve:c3"
  ],
  "main": "./dist/extension.js",
  "dependencies": {
    "decompress": "^4.2.1",
    "semver": "^7.6.3",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.1.0",
    "mocha": "^11.7.5"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.3"
  },
  "scripts": {
    "build": "node ./build_syntax.js && npm run esbuild-base -- --minify && npx @vscode/vsce package -o vscode-c3.vsix",
    "esbuild-base": "esbuild ./src/extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "test": "node ./src/test/runTest.js"
  }
}


{
    "struct definition": {
        "prefix": ["struct"],
        "body": [
            "struct ${1:name}{",
                "\t${0}",
            "}"
        ]
    },
    "arrays declaration": {
        "prefix": ["array"],
        "body": [
            "${1:type}[] ${2:name} = {${3:elements}};"
        ]
    },
    "function": {
        "prefix": ["fn"],
        "body": [
            "fn ${1:type} ${2:name}(${3:args}) {",
                "\t${0}",
            "}"
        ]
    },
    "call external c function":{
        "prefix": ["cfunction"],
        "body": [
            "extern fn ${1:type} ${2:c3_name}(${3:args}) @cname(\"${4:c_name}\");"
        ]

    },

    "variable declaration": {
        "prefix": ["var"],
        "body": [
            "${1:type} ${2:name};"
        ]
    },
    "variable declaration with assignment": { 
        "prefix": ["vassign"],
        "body": [
            "${1:type} ${2:name} = ${3:value};"
        ]
    },
    "variable declaration non-init": { 
        "prefix": ["vnoinit"],
        "body": [
            "${1:type} ${2:name} @noinit;"
        ]
    },
    "alias": {
        "prefix": ["alias"],
        "body": [
            "alias ${1:Name} = ${2:Type};"
        ]
    },
    "typedef": {
        "prefix": ["typedef"],
        "body": [
            "typedef ${1:Name} = ${2:Type};"
        ]
    },
    "excuse": {
        "prefix": ["excuse"],
        "body": [
            "excuse ${1:NAME};"
        ]
    },
    "constset": {
        "prefix": ["constset"],
        "body": [
            "constset ${1:Name} : inline ${2:int}",
            "{",
                "\t${3:A} = ${4:1},",
            "}"
        ]
    },
    "module definition": {
        "prefix": ["module"],
        "body": [
            "module ${1:name}::${2:filename};"
        ]
    },
    "switch statement":{
        "prefix": ["switch"],
        "body": [
            "switch (${1:expr})", 
            "{",
                "case ${2:value}:",
                    "\t${3}",
                "default:",
                    "\t${0}",

            "}"
        ] 

    },
    "do":{
        "prefix": ["do"],
        "body": [
            "do",
            "{",
                "\t${0}",
            "}"
        ]
    },
    "if statement": {
        "prefix": ["if"],
        "body": [
            "if (${1:expr})",
            "{",
                "\t${0}",
            "}"
        ]
    },
    "else if statement": {
        "prefix": ["elsif"],
        "body": [
            "else if (${1:expr})",
            "{",
                "\t${0}",
            "}"
        ]
    },
    "else statement": {
        "prefix": ["else"],
        "body": [
            "else", 
            "{",
                "\t${0}",
            "}"
        ]
    },   
    "case statement": {
        "prefix": ["case"],
        "body": [
            "case ${1:value}:",
                "\t${2}",
            "${0}"
        ]
    },
    "for loop": {
        "prefix": ["for"],
        "body": [
            "for (${1:type} ${2:name} = ${2:startexpr}; ${2:name} < ${3:endexpr}; ${2:name} += ${4:delta})",
            "{",
                "\t${0}",
            "}"
        ]
    },
    "foreach": {
        "prefix": ["foreach"],
        "body": [
            "foreach (${1:loopvar} : ${2:elements})",
            "{",
                "\t${0}",
            "}"
        ]
    }
}

